## 5. Main JUCE AudioProcessor Implementation (`PluginProcessor.h` & `PluginProcessor.cpp`)

Integrates host sync, parameter management, MIDI output generation, and audio rendering.

### `PluginProcessor.h`

```cpp
#pragma once
#include <JuceHeader.h>
#include "Engine/PercussionEngineTypes.h"
#include "Engine/SequencerEngine.h"
#include "Engine/HatStateMachine.h"

class HiHatPercProgrammerAudioProcessor : public juce::AudioProcessor
{
public:
    HiHatPercProgrammerAudioProcessor();
    ~HiHatPercProgrammerAudioProcessor() override;

    void prepareToPlay(double sampleRate, int samplesPerBlock) override;
    void releaseResources() override;
    void processBlock(juce::AudioBuffer<float>& buffer, juce::MidiBuffer& midiMessages) override;

    juce::AudioProcessorEditor* createEditor() override;
    bool hasEditor() const override { return true; }

    const juce::String getName() const override { return "HiHat Perc Programmer"; }
    bool acceptsMidi() const override { return true; }
    bool producesMidi() const override { return true; }
    bool isMidiEffect() const override { return false; }
    double getTailLengthSeconds() const override { return 0.0; }

    int getNumPrograms() override { return 1; }
    int getCurrentProgram() override { return 0; }
    void setCurrentProgram(int) override {}
    const juce::String getProgramName(int) override { return "Default"; }
    void changeProgramName(int, const juce::String&) override {}

    void getStateInformation(juce::MemoryBlock& destData) override;
    void setStateInformation(const void* data, int sizeInBytes) override;

    juce::AudioProcessorValueTreeState& getAPVTS() { return apvts; }

private:
    juce::AudioProcessorValueTreeState apvts;
    juce::AudioProcessorValueTreeState::ParameterLayout createParameterLayout();

    PercussionEngine::SequencerEngine sequencer;
    PercussionEngine::HatStateMachine hatStateMachine;
    juce::Array<PercussionEngine::PercussionEvent> eventQueue;

    JUCE_DECLARE_NON_COPYABLE_WITH_LEAK_DETECTOR(HiHatPercProgrammerAudioProcessor)
};

```

### `PluginProcessor.cpp`

```cpp
#include "PluginProcessor.h"

HiHatPercProgrammerAudioProcessor::HiHatPercProgrammerAudioProcessor()
    : AudioProcessor(BusesProperties()
        .withOutput("Output", juce::AudioChannelSet::stereo(), true)),
      apvts(*this, nullptr, "Parameters", createParameterLayout())
{
    // Initialize default 16th pattern
    for (int i = 0; i < 16; ++i)
    {
        PercussionEngine::SequencerStep step;
        step.active = (i % 2 == 0); // Active on 8th notes
        step.baseVelocity = (i % 4 == 0) ? 1.0f : 0.6f; // Accents on downbeats
        step.probability = 1.0f;
        step.hatOpenness = (i == 14) ? 0.9f : 0.0f; // Open hat on step 14
        sequencer.setStep(i, step);
    }
}

HiHatPercProgrammerAudioProcessor::~HiHatPercProgrammerAudioProcessor() = default;

juce::AudioProcessorValueTreeState::ParameterLayout HiHatPercProgrammerAudioProcessor::createParameterLayout()
{
    std::vector<std::unique_ptr<juce::RangedAudioParameter>> params;

    params.push_back(std::make_unique<juce::AudioParameterFloat>(
        juce::ParameterID{"swing", 1}, "Swing %", 50.0f, 75.0f, 50.0f));
    params.push_back(std::make_unique<juce::AudioParameterFloat>(
        juce::ParameterID{"jitter", 1}, "Timing Jitter (ms)", 0.0f, 15.0f, 2.0f));
    params.push_back(std::make_unique<juce::AudioParameterFloat>(
        juce::ParameterID{"hatOpenness", 1}, "Global Hat Openness", 0.0f, 1.0f, 0.0f));

    return { params.begin(), params.end() };
}

void HiHatPercProgrammerAudioProcessor::prepareToPlay(double sampleRate, int samplesPerBlock)
{
    sequencer.prepare(sampleRate, samplesPerBlock);
    eventQueue.ensureStorageAllocated(64);
}

void HiHatPercProgrammerAudioProcessor::releaseResources() {}

void HiHatPercProgrammerAudioProcessor::processBlock(juce::AudioBuffer<float>& buffer, juce::MidiBuffer& midiMessages)
{
    juce::ScopedNoDenormals noDenormals;
    buffer.clear();
    eventQueue.clearQuick();

    // 1. Evaluate Pattern Sequencer against Host Playhead
    sequencer.processBlock(getPlayHead(), buffer.getNumSamples(), eventQueue);

    // 2. Convert scheduled events into outgoing MIDI events for host/VST routing
    for (const auto& evt : eventQueue)
    {
        // Map instrumentId/openness to MIDI notes
        // Note 42 = Closed Hi-Hat, Note 46 = Open Hi-Hat
        int midiNote = (evt.hatOpenness > 0.5f) ? 46 : 42;
        uint8_t midiVel = static_cast<uint8_t>(evt.velocity * 127.0f);

        auto noteOn = juce::MidiMessage::noteOn(1, midiNote, midiVel);
        auto noteOff = juce::MidiMessage::noteOff(1, midiNote);

        midiMessages.addEvent(noteOn, evt.sampleOffset);
        // Schedule note off 100 samples later for clean triggering
        midiMessages.addEvent(noteOff, juce::jmin(buffer.getNumSamples() - 1, evt.sampleOffset + 100));
    }
}

juce::AudioProcessorEditor* HiHatPercProgrammerAudioProcessor::createEditor()
{
    return new juce::GenericAudioProcessorEditor(*this);
}

void HiHatPercProgrammerAudioProcessor::getStateInformation(juce::MemoryBlock& destData)
{
    auto state = apvts.copyState();
    std::unique_ptr<juce::XmlElement> xml(state.createXml());
    copyXmlToBinary(*xml, destData);
}

void HiHatPercProgrammerAudioProcessor::setStateInformation(const void* data, int sizeInBytes)
{
    std::unique_ptr<juce::XmlElement> xmlState(getXmlFromBinary(data, sizeInBytes));
    if (xmlState != nullptr && xmlState->hasTagName(apvts.state.getType()))
    {
        apvts.replaceState(juce::ValueTree::fromXml(*xmlState));
    }
}

// JUCE Plugin Entry Point
juce::AudioProcessor* JUCE_CALLTYPE createPluginFilter()
{
    return new HiHatPercProgrammerAudioProcessor();
}

