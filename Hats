Here is a modular, production-ready C++ class architecture and core `AudioProcessor` implementation for building the hi-hat/percussion programmer in **JUCE**.

---

## 1. Engine Data Types & Data Structures (`PercussionEngineTypes.h`)

Define lock-free event objects and data structures to represent incoming steps, dynamic parameters, and voice states.

```cpp
#pragma once
#include <JuceHeader.h>

namespace PercussionEngine
{
    // High-resolution percussion event passed from Sequencer to Synth
    struct PercussionEvent
    {
        int sampleOffset = 0;             // Sample offset within current audio block
        int instrumentId = 0;             // 0: Closed Hat, 1: Open Hat, 2: Perc, etc.
        float velocity = 0.8f;            // 0.0f to 1.0f
        float timingOffsetMs = 0.0f;      // Micro-timing offset (-20.0ms to +20.0ms)
        float hatOpenness = 0.0f;         // 0.0f (Tight Closed) to 1.0f (Full Open)
        float pitchShiftSemitones = 0.0f; // -12.0f to +12.0f
        float pan = 0.0f;                 // -1.0f (Left) to +1.0f (Right)
        int chokeGroup = 1;               // 0 = None, 1 = Hi-Hat Group
    };

    // Sequencer Step definition
    struct SequencerStep
    {
        bool active = false;
        float baseVelocity = 0.8f;
        float probability = 1.0f;         // 0.0f to 1.0f trigger probability
        int rollSubdivision = 1;          // 1 = normal, 2 = 32nd roll, 4 = 64th roll
        float rollPitchRamp = 0.0f;       // Semitones to sweep across a roll
        float hatOpenness = 0.0f;
    };

    // Parameters for humanization / drift
    struct HumanizerParams
    {
        float timingJitterMs = 2.0f;      // Short-term random time offset
        float timingDriftMs = 5.0f;       // LFO-based slow tempo drift
        float velocityJitter = 0.05f;     // Random velocity fluctuation
        float swingPercent = 50.0f;       // 50.0 = Straight, 66.6 = Triplet Swing
    };
}

