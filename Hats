## 4. Sequencer Engine (`SequencerEngine.h`)

Tracks host PPQ (Pulse Per Quarter Note) position, evaluates probability/rolls, and schedules sample-accurate `PercussionEvent` objects into a fifo buffer.

```cpp
#pragma once
#include <JuceHeader.h>
#include "PercussionEngineTypes.h"
#include "Humanizer.h"

namespace PercussionEngine
{
    class SequencerEngine
    {
    public:
        SequencerEngine() = default;

        void prepare(double sampleRate, int maxBlockSize)
        {
            currentSampleRate = sampleRate;
            juce::ignoreUnused(maxBlockSize);
        }

        // Main evaluation routine called inside AudioProcessor::processBlock
        void processBlock(juce::AudioPlayHead* playHead, 
                          int numSamples, 
                          juce::Array<PercussionEvent>& outEventQueue)
        {
            if (playHead == nullptr) return;

            auto positionOpt = playHead->getPosition();
            if (!positionOpt.has_value()) return;

            const auto& pos = *positionOpt;
            if (!pos.getIsPlaying()) return;

            double bpm = pos.getBpm().orFallback(120.0);
            double ppqPosition = pos.getPpqPosition().orFallback(0.0);

            double secondsPerQuarter = 60.0 / bpm;
            double samplesPerQuarter = secondsPerQuarter * currentSampleRate;

            // Compute block end position in PPQ
            double quarterNotesInBlock = static_cast<double>(numSamples) / samplesPerQuarter;
            double blockStartPpq = ppqPosition;
            double blockEndPpq = blockStartPpq + quarterNotesInBlock;

            // Evaluate 16th-note steps within this block range
            double ppqPer16th = 0.25; // 1/4 of a quarter note
            int startStep = static_cast<int>(std::floor(blockStartPpq / ppqPer16th));
            int endStep = static_cast<int>(std::ceil(blockEndPpq / ppqPer16th));

            for (int step = startStep; step <= endStep; ++step)
            {
                double stepPpq = step * ppqPer16th;

                // Check if step falls within the current audio block boundary
                if (stepPpq >= blockStartPpq && stepPpq < blockEndPpq)
                {
                    int stepIndexInPattern = step % 16;
                    const auto& patternStep = pattern[stepIndexInPattern];

                    if (patternStep.active && random.nextFloat() <= patternStep.probability)
                    {
                        PercussionEvent evt;
                        
                        // Calculate sample offset within current block
                        double ppqOffset = stepPpq - blockStartPpq;
                        evt.sampleOffset = juce::jlimit(0, numSamples - 1, static_cast<int>(ppqOffset * samplesPerQuarter));
                        
                        // Apply Humanization & Micro-timing
                        float microTimingMs = humanizer.calculateTimingOffset(humanizerParams, stepPpq);
                        int sampleJitter = static_cast<int>((microTimingMs / 1000.0) * currentSampleRate);
                        evt.sampleOffset = juce::jlimit(0, numSamples - 1, evt.sampleOffset + sampleJitter);

                        evt.velocity = juce::jlimit(0.0f, 1.0f, patternStep.baseVelocity + humanizer.calculateVelocityOffset(humanizerParams));
                        evt.hatOpenness = patternStep.hatOpenness;
                        evt.chokeGroup = 1;

                        outEventQueue.add(evt);
                    }
                }
            }
        }

        void setStep(int index, const SequencerStep& step) { pattern[index] = step; }

    private:
        double currentSampleRate = 44100.0;
        SequencerStep pattern[16];
        Humanizer humanizer;
        HumanizerParams humanizerParams;
        juce::Random random;
    };
}

```

