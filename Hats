## 2. Multi-Zone Hi-Hat State Machine (`HatStateMachine.h`)

Handles the continuous openness parameter ($0.0 - 1.0$) and evaluates choke events across active audio voices.

```cpp
#pragma once
#include "PercussionEngineTypes.h"

namespace PercussionEngine
{
    enum class HatZone
    {
        TightClosed,
        LooseClosed,
        HalfOpen,
        FullOpen
    };

    class HatStateMachine
    {
    public:
        HatStateMachine() = default;

        // Maps continuous openness (0.0 to 1.0) to articulation zones
        static HatZone getZoneFromOpenness(float openness)
        {
            if (openness < 0.2f) return HatZone::TightClosed;
            if (openness < 0.5f) return HatZone::LooseClosed;
            if (openness < 0.8f) return HatZone::HalfOpen;
            return HatZone::FullOpen;
        }

        // Returns choke dampening multiplier for active open hat voices
        float calculateChokeEnvelope(bool isChoking, float currentDampening, float releaseRate)
        {
            if (isChoking)
            {
                // Quick exponential dampening (2ms-5ms fast decay)
                return currentDampening * releaseRate;
            }
            return 1.0f;
        }
    };
}

