## 3. Humanizer & Timing Drift Engine (`Humanizer.h`)

Combines white noise jitter with a Perlin-style LFO drift to simulate human drummer micro-timing.

```cpp
#pragma once
#include <JuceHeader.h>
#include "PercussionEngineTypes.h"

namespace PercussionEngine
{
    class Humanizer
    {
    public:
        Humanizer()
        {
            random.setSeedRandomly();
        }

        float calculateTimingOffset(const HumanizerParams& params, double currentPpq)
        {
            // 1. Short-term random jitter (-1.0 to 1.0)
            float jitter = random.nextFloat() * 2.0f - 1.0f;
            float jitterOffsetMs = jitter * params.timingJitterMs;

            // 2. Long-term drift using low-frequency sine/LFO
            float driftMs = std::sin(currentPpq * 0.25) * params.timingDriftMs;

            return jitterOffsetMs + driftMs;
        }

        float calculateVelocityOffset(const HumanizerParams& params)
        {
            float jitter = random.nextFloat() * 2.0f - 1.0f;
            return jitter * params.velocityJitter;
        }

    private:
        juce::Random random;
    };
}

