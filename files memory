Here is how to implement real-time MIDI input recording with auto-quantization and swing alignment directly inside your JUCE sequencing engine.

This implementation captures incoming live performance hits from external pads, maps them to the host transport timeline, quantizes them to the nearest grid or swing offset, and writes them directly into the pattern memory.

---

## 1. Real-Time Performance Engine Architecture

To record live performance without audio jitter or latency artifacts, input capture occurs on the audio thread inside `processBlock`, while state synchronization uses atomic flags.

```
 [Live MIDI Pad Input]
          │
          ▼
 [Real-Time Block Recorder] ──► Query Host Playhead (PPQ & Sample Offset)
          │
          ▼
 [Quantization & Swing Engine] ──► Snap to 16th / 32nd Grid + Apply Micro-Swing
          │
          ▼
 [Pattern Memory Update] ──► Overwrite / Merge active Sequencer Steps

```

---

## 2. Quantization Logic & Math (`Quantizer.h`)

This utility handles grid snapping ($1/16$, $1/32$, or $1/16\text{T}$) and applies user-defined swing percentages.

```cpp
#pragma once
#include <JuceHeader.h>
#include "Engine/PercussionEngineTypes.h"

namespace PercussionEngine
{
    enum class QuantizeGrid
    {
        Sixteenth,        // 1/16 Note (0.25 PPQ)
        ThirtySecond,     // 1/32 Note (0.125 PPQ)
        SixteenthTriplet, // 1/16T (0.1667 PPQ)
        Off               // No quantization
    };

    class Quantizer
    {
    public:
        // Returns quantized PPQ position and calculated micro-timing offset (ms)
        static void quantizePpq(double rawPpq,
                                QuantizeGrid grid,
                                float swingPercent,
                                double bpm,
                                double& outQuantizedPpq,
                                float& outTimingOffsetMs)
        {
            if (grid == QuantizeGrid::Off)
            {
                outQuantizedPpq = rawPpq;
                outTimingOffsetMs = 0.0f;
                return;
            }

            double stepSizePpq = getGridPpq(grid);

            // 1. Find nearest grid step
            double nearestStepIndex = std::round(rawPpq / stepSizePpq);
            double baseQuantizedPpq = nearestStepIndex * stepSizePpq;

            // 2. Apply Swing offset to odd steps (16th note swing)
            double finalPpq = baseQuantizedPpq;
            int step16thIndex = static_cast<int>(std::round(baseQuantizedPpq / 0.25));

            if (step16thIndex % 2 != 0 && swingPercent > 50.0f)
            {
                // Swing offset shifts odd 16th notes toward 16th triplets (50% = straight, 66.7% = triplet)
                double swingOffsetPpq = (swingPercent - 50.0f) / 100.0f * (0.25 / 3.0);
                finalPpq += swingOffsetPpq;
            }

            // 3. Compute micro-timing offset in milliseconds relative to straight grid
            double deltaPpq = rawPpq - baseQuantizedPpq;
            double secondsPerPpq = 60.0 / (bpm * 1.0);
            outTimingOffsetMs = static_cast<float>(deltaPpq * secondsPerPpq * 1000.0);

            outQuantizedPpq = finalPpq;
        }

    private:
        static double getGridPpq(QuantizeGrid grid)
        {
            switch (grid)
            {
                case QuantizeGrid::Sixteenth:        return 0.25;
                case QuantizeGrid::ThirtySecond:     return 0.125;
                case QuantizeGrid::SixteenthTriplet: return 0.25 / 1.5; // ~0.1667
                default:                             return 0.25;
            }
        }
    };
}

