## 4. AudioProcessor Integration

Hook `LiveRecorder` into `HiHatPercProgrammerAudioProcessor::processBlock` to handle live MIDI pad input concurrently with pattern playback.

```cpp
void HiHatPercProgrammerAudioProcessor::processBlock(juce::AudioBuffer<float>& buffer, juce::MidiBuffer& midiMessages)
{
    juce::ScopedNoDenormals noDenormals;
    
    // 1. Capture and Quantize incoming live MIDI performance hits
    if (liveRecorder.isRecordingEnabled())
    {
        liveRecorder.processIncomingMidi(
            midiMessages, 
            getPlayHead(), 
            buffer.getNumSamples(), 
            getSampleRate(), 
            patternMemory
        );
    }

    buffer.clear();
    eventQueue.clearQuick();

    // 2. Evaluate active pattern sequencer against Host Playhead
    sequencer.processBlock(getPlayHead(), buffer.getNumSamples(), eventQueue);

    // 3. Render Voice Pool DSP Output
    for (const auto& evt : eventQueue)
    {
        const juce::AudioBuffer<float>* targetSample = sampleManager.getSampleSlot(evt.instrumentId);
        voicePool.triggerNote(
            targetSample,
            evt.pitchShiftSemitones,
            evt.velocity,
            evt.pan,
            evt.chokeGroup
        );
    }

    voicePool.renderNextBlock(buffer, 0, buffer.getNumSamples());
}

