## 3. Real-Time Live Recorder (`LiveRecorder.h`)

Tracks incoming `MidiMessage` objects from external pads during playback, computes absolute PPQ positions, quantizes them, and updates the pattern array.

```cpp
#pragma once
#include <JuceHeader.h>
#include "Quantizer.h"
#include "PercussionEngineTypes.h"

namespace PercussionEngine
{
    class LiveRecorder
    {
    public:
        LiveRecorder() = default;

        void setRecordingEnabled(bool enabled) { isRecording.store(enabled); }
        bool isRecordingEnabled() const { return isRecording.load(); }

        void setQuantizeGrid(QuantizeGrid grid) { currentGrid = grid; }
        void setSwingPercent(float swing) { swingPercent = swing; }

        // Process incoming MIDI buffer during AudioProcessor::processBlock
        void processIncomingMidi(const juce::MidiBuffer& incomingMidi,
                                 juce::AudioPlayHead* playHead,
                                 int numSamples,
                                 double sampleRate,
                                 std::array<SequencerStep, 16>& targetPattern)
        {
            if (!isRecording.load() || playHead == nullptr) return;

            auto posOpt = playHead->getPosition();
            if (!posOpt.has_value()) return;

            const auto& pos = *posOpt;
            if (!pos.getIsPlaying()) return;

            double bpm = pos.getBpm().orFallback(120.0);
            double blockStartPpq = pos.getPpqPosition().orFallback(0.0);
            double secondsPerQuarter = 60.0 / bpm;
            double samplesPerQuarter = secondsPerQuarter * sampleRate;

            for (const auto metadata : incomingMidi)
            {
                auto msg = metadata.getMessage();

                // Process Note On events (Hi-Hat pads)
                if (msg.isNoteOn())
                {
                    int sampleOffsetInBlock = metadata.samplePosition;
                    double notePpqInBlock = static_cast<double>(sampleOffsetInBlock) / samplesPerQuarter;
                    double rawAbsolutePpq = blockStartPpq + notePpqInBlock;

                    // Compute Quantization
                    double quantizedPpq = 0.0;
                    float timingOffsetMs = 0.0f;
                    Quantizer::quantizePpq(rawAbsolutePpq, currentGrid, swingPercent, bpm, quantizedPpq, timingOffsetMs);

                    // Map quantized PPQ back to 16-step pattern index (0-15)
                    int stepIndex = static_cast<int>(std::round(quantizedPpq / 0.25)) % 16;
                    if (stepIndex < 0) stepIndex += 16;

                    // Update pattern step parameters
                    SequencerStep newStep;
                    newStep.active = true;
                    newStep.baseVelocity = msg.getFloatVelocity();
                    
                    // Map Note 46 (Open Hat) vs Note 42 (Closed Hat) to Openness
                    newStep.hatOpenness = (msg.getNoteNumber() == 46) ? 0.9f : 0.0f;

                    targetPattern[stepIndex] = newStep;
                }
            }
        }

    private:
        std::atomic<bool> isRecording{ false };
        QuantizeGrid currentGrid = QuantizeGrid::Sixteenth;
        float swingPercent = 50.0f;
    };
}

