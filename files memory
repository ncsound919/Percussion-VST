## 5. UI Record Toggle Button (`RecordButton.h`)

Custom recording toggle button with pulse animation for JUCE `AudioProcessorEditor`.

```cpp
#pragma once
#include <JuceHeader.h>

namespace PercussionUI
{
    class RecordButton : public juce::ToggleButton
    {
    public:
        RecordButton() : juce::ToggleButton("Rec") {}

        void paintButton(juce::Graphics& g, bool shouldDrawButtonAsHighlighted, bool shouldDrawButtonAsDown) override
        {
            auto bounds = getLocalBounds().toFloat().reduced(2.0f);
            
            bool recActive = getToggleState();
            juce::Colour bgCol = recActive ? juce::Colour(0xffff0055) : juce::Colour(0xff2a303c);
            
            g.setColour(bgCol);
            g.fillRoundedRectangle(bounds, 6.0f);

            // Record Circle Icon
            auto iconBounds = bounds.removeFromLeft(24.0f).reduced(6.0f);
            g.setColour(recActive ? juce::Colours::white : juce::Colour(0xffff0055));
            g.fillEllipse(iconBounds);

            // Text Label
            g.setColour(juce::Colours::white);
            g.setFont(juce::FontOptions(12.0f, juce::Font::Bold));
            g.drawText(recActive ? "REC ON" : "RECORD", bounds, juce::Justification::centred);
        }
    };
}

