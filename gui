## 3. Step Pitch Sweep & Roll Inspector Component (`StepInspectorComponent.h`)

This panel controls the fine parameters for whichever step is currently selected.

```cpp
#pragma once
#include <JuceHeader.h>
#include "Engine/RollData.h"

namespace PercussionUI
{
    class StepInspectorComponent : public juce::Component
    {
    public:
        std::function<void(const PercussionEngine::StepRollConfig&)> onConfigChanged;

        StepInspectorComponent()
        {
            // Roll Type Selector
            rollTypeBox.addItem("No Roll (Single Hit)", 1);
            rollTypeBox.addItem("1/32nd Straight", 2);
            rollTypeBox.addItem("1/64th Straight", 3);
            rollTypeBox.addItem("1/32nd Triplet (1/48)", 4);
            rollTypeBox.addItem("1/64th Triplet (1/96)", 5);
            rollTypeBox.setSelectedId(1);
            rollTypeBox.onChange = [this] { updateConfig(); };
            addAndMakeVisible(rollTypeBox);

            // Pitch Curve Selector
            pitchCurveBox.addItem("Linear Sweep", 1);
            pitchCurveBox.addItem("Exponential Sweep", 2);
            pitchCurveBox.addItem("Logarithmic Sweep", 3);
            pitchCurveBox.setSelectedId(1);
            pitchCurveBox.onChange = [this] { updateConfig(); };
            addAndMakeVisible(pitchCurveBox);

            // Pitch Sliders (-12 to +12 semitones)
            setupSlider(startPitchSlider, -12.0f, 12.0f, 0.0f, "st");
            setupSlider(endPitchSlider, -12.0f, 12.0f, 0.0f, "st");

            // Pan Sliders (-1.0 to +1.0)
            setupSlider(panStartSlider, -1.0f, 1.0f, 0.0f, "");
            setupSlider(panEndSlider, -1.0f, 1.0f, 0.0f, "");
        }

        void inspectStep(int stepIndex, const PercussionEngine::StepRollConfig& config)
        {
            selectedStep = stepIndex;
            currentConfig = config;

            rollTypeBox.setSelectedId(static_cast<int>(config.type) + 1, juce::dontSendNotification);
            pitchCurveBox.setSelectedId(static_cast<int>(config.pitchCurve) + 1, juce::dontSendNotification);

            startPitchSlider.setValue(config.startPitchOffset, juce::dontSendNotification);
            endPitchSlider.setValue(config.endPitchOffset, juce::dontSendNotification);
            panStartSlider.setValue(config.panStart, juce::dontSendNotification);
            panEndSlider.setValue(config.panEnd, juce::dontSendNotification);

            repaint();
        }

        void resized() override
        {
            auto area = getLocalBounds().reduced(8);
            auto topRow = area.removeFromTop(28);

            rollTypeBox.setBounds(topRow.removeFromLeft(180));
            topRow.removeFromLeft(12);
            pitchCurveBox.setBounds(topRow.removeFromLeft(180));

            area.removeFromTop(8);
            auto pitchRow = area.removeFromTop(40);
            startPitchSlider.setBounds(pitchRow.removeFromLeft(200));
            pitchRow.removeFromLeft(12);
            endPitchSlider.setBounds(pitchRow.removeFromLeft(200));

            area.removeFromTop(8);
            auto panRow = area.removeFromTop(40);
            panStartSlider.setBounds(panRow.removeFromLeft(200));
            panRow.removeFromLeft(12);
            panEndSlider.setBounds(panRow.removeFromLeft(200));
        }

    private:
        void setupSlider(juce::Slider& slider, float min, float max, float def, const juce::String& suffix)
        {
            slider.setRange(min, max, 0.1);
            slider.setValue(def);
            slider.setTextValueSuffix(" " + suffix);
            slider.setSliderStyle(juce::Slider::LinearHorizontal);
            slider.setTextBoxStyle(juce::Slider::TextBoxRight, false, 60, 20);
            slider.onValueChange = [this] { updateConfig(); };
            addAndMakeVisible(slider);
        }

        void updateConfig()
        {
            currentConfig.type = static_cast<PercussionEngine::RollType>(rollTypeBox.getSelectedId() - 1);
            currentConfig.pitchCurve = static_cast<PercussionEngine::PitchRampCurve>(pitchCurveBox.getSelectedId() - 1);
            currentConfig.startPitchOffset = static_cast<float>(startPitchSlider.getValue());
            currentConfig.endPitchOffset = static_cast<float>(endPitchSlider.getValue());
            currentConfig.panStart = static_cast<float>(panStartSlider.getValue());
            currentConfig.panEnd = static_cast<float>(panEndSlider.getValue());

            if (onConfigChanged)
                onConfigChanged(currentConfig);
        }

        int selectedStep = 0;
        PercussionEngine::StepRollConfig currentConfig;

        juce::ComboBox rollTypeBox;
        juce::ComboBox pitchCurveBox;
        juce::Slider startPitchSlider;
        juce::Slider endPitchSlider;
        juce::Slider panStartSlider;
        juce::Slider panEndSlider;
    };
}

