## 4. Main Grid Component (`SequencerGridComponent.h`)

Combines the 16 step buttons into beat groups (4 bars of 4 steps) and connects clicks directly to the `StepInspectorComponent`.

```cpp
#pragma once
#include <JuceHeader.h>
#include "StepButton.h"
#include "StepInspectorComponent.h"
#include "PluginProcessor.h"

namespace PercussionUI
{
    class SequencerGridComponent : public juce::Component
    {
    public:
        SequencerGridComponent(HiHatPercProgrammerAudioProcessor& p) : processor(p)
        {
            for (int i = 0; i < 16; ++i)
            {
                auto btn = std::make_unique<StepButton>(i);
                btn->onClick = [this, i] { selectStep(i); };
                stepButtons.add(std::move(btn));
                addAndMakeVisible(stepButtons.getLast());
            }

            inspector.onConfigChanged = [this](const PercussionEngine::StepRollConfig& config) {
                processor.setStepRollConfig(selectedStepIndex, config);
                stepButtons[selectedStepIndex]->repaint();
            };

            addAndMakeVisible(inspector);
            selectStep(0);
        }

        void selectStep(int index)
        {
            selectedStepIndex = index;
            auto config = processor.getStepRollConfig(index);
            inspector.inspectStep(index, config);
        }

        void resized() override
        {
            auto area = getLocalBounds().reduced(10);
            
            // Grid Top Layout (16 Steps split into 4 beat blocks)
            auto gridArea = area.removeFromTop(70);
            int stepWidth = (gridArea.getWidth() - (3 * 12)) / 16; // 12px gap between quarter-note beats

            for (int i = 0; i < 16; ++i)
            {
                int beatSpacing = (i / 4) * 12; // Extra gap every 4th step
                stepButtons[i]->setBounds(i * stepWidth + beatSpacing, 0, stepWidth - 2, 64);
            }

            area.removeFromTop(12);
            inspector.setBounds(area);
        }

    private:
        HiHatPercProgrammerAudioProcessor& processor;
        juce::OwnedArray<StepButton> stepButtons;
        StepInspectorComponent inspector;
        int selectedStepIndex = 0;
    };
}

```

