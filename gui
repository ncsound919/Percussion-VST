## 2. Interactive Single-Step GUI Button (`StepButton.h`)

Custom JUCE `Button` sub-class rendering velocity heatmaps and roll badges.

```cpp
#pragma once
#include <JuceHeader.h>
#include "Engine/RollData.h"

namespace PercussionUI
{
    class StepButton : public juce::Button
    {
    public:
        StepButton(int stepIdx) 
            : juce::Button("Step_" + juce::String(stepIdx)), stepIndex(stepIdx)
        {
            setClickingTogglesState(true);
        }

        void setStepData(bool isActive, float velocity, PercussionEngine::RollType rollType)
        {
            setToggleState(isActive, juce::dontSendNotification);
            currentVelocity = velocity;
            currentRollType = rollType;
            repaint();
        }

        int getStepIndex() const { return stepIndex; }

        void paintButton(juce::Graphics& g, bool shouldDrawButtonAsHighlighted, bool shouldDrawButtonAsDown) override
        {
            auto bounds = getLocalBounds().toFloat().reduced(2.0f);
            
            // Base background
            juce::Colour baseColor = getToggleState() 
                ? juce::Colour(0xff00e5ff).withAlpha(0.3f + 0.7f * currentVelocity) // Cyan active fill
                : juce::Colour(0xff1e222b);                                         // Dark inactive fill

            if (shouldDrawButtonAsHighlighted)
                baseColor = baseColor.brighter(0.2f);

            g.setColour(baseColor);
            g.fillRoundedRectangle(bounds, 6.0f);

            // Border
            g.setColour(getToggleState() ? juce::Colour(0xff00e5ff) : juce::Colour(0xff3a4252));
            g.drawRoundedRectangle(bounds, 6.0f, getToggleState() ? 2.0f : 1.0f);

            // Step Number
            g.setColour(getToggleState() ? juce::Colours::white : juce::Colour(0xff8a94a6));
            g.setFont(juce::FontOptions(12.0f, juce::Font::Bold));
            g.drawText(juce::String(stepIndex + 1), bounds.removeFromTop(16.0f), juce::Justification::centred);

            // Roll Badge Label
            if (currentRollType != PercussionEngine::RollType::None)
            {
                juce::String badgeText = getRollBadgeText(currentRollType);
                auto badgeBounds = bounds.removeFromBottom(14.0f).reduced(2.0f, 0.0f);
                
                g.setColour(juce::Colour(0xffff0055)); // Hot pink roll badge
                g.fillRoundedRectangle(badgeBounds, 3.0f);

                g.setColour(juce::Colours::white);
                g.setFont(juce::FontOptions(9.0f, juce::Font::Bold));
                g.drawText(badgeText, badgeBounds, juce::Justification::centred);
            }
        }

    private:
        juce::String getRollBadgeText(PercussionEngine::RollType type)
        {
            switch (type)
            {
                case PercussionEngine::RollType::Straight_32nd: return "32nd";
                case PercussionEngine::RollType::Straight_64th: return "64th";
                case PercussionEngine::RollType::Triplet_32ndT: return "32T";
                case PercussionEngine::RollType::Triplet_64thT: return "64T";
                default: return "";
            }
        }

        int stepIndex;
        float currentVelocity = 0.8f;
        PercussionEngine::RollType currentRollType = PercussionEngine::RollType::None;
    };
}

```

