## 2. Sample Memory Manager (`SampleManager.h`)

This thread-safe loader decodes dropped audio files on a background thread and updates the `AudioBuffer` reference without blocking the audio thread.

```cpp
#pragma once
#include <JuceHeader.h>

namespace PercussionEngine
{
    class SampleManager
    {
    public:
        SampleManager()
        {
            formatManager.registerBasicFormats();
        }

        bool loadSampleFromFile(const juce::File& file, int slotIndex)
        {
            std::unique_ptr<juce::AudioFormatReader> reader(formatManager.createReaderFor(file));
            if (reader != nullptr)
            {
                auto newBuffer = std::make_unique<juce::AudioBuffer<float>>(
                    static_cast<int>(reader->numChannels), 
                    static_cast<int>(reader->lengthInSamples)
                );

                reader->read(newBuffer.get(), 0, static_cast<int>(reader->lengthInSamples), 0, true, true);

                // Safely swap pointer in thread-safe memory array
                juce::ScopedLock sl(lock);
                sampleSlots[slotIndex] = std::move(newBuffer);
                return true;
            }
            return false;
        }

        const juce::AudioBuffer<float>* getSampleSlot(int slotIndex) const
        {
            juce::ScopedLock sl(lock);
            if (slotIndex >= 0 && slotIndex < MaxSlots && sampleSlots[slotIndex] != nullptr)
            {
                return sampleSlots[slotIndex].get();
            }
            return nullptr;
        }

    private:
        static constexpr int MaxSlots = 8;
        juce::AudioFormatManager formatManager;
        std::array<std::unique_ptr<juce::AudioBuffer<float>>, MaxSlots> sampleSlots;
        mutable juce::CriticalSection lock;
    };
}

