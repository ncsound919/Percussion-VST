Here is how to extend your JUCE C++ engine to support **drag-and-drop sample file uploads** and **live interactive pattern programming** for acoustic breakbeats, live drums, and percussion.

---

## 1. Drag-and-Drop Sample Upload (`FileDropTarget.h`)

By inheriting from `juce::FileDragAndDropTarget`, your UI components can directly accept dropped `.wav`, `.aif`, or `.flac` audio files from the operating system or DAW file browser.

```cpp
#pragma once
#include <JuceHeader.h>

namespace PercussionUI
{
    class SampleDropZone : public juce::Component,
                           public juce::FileDragAndDropTarget
    {
    public:
        std::function<void(const juce::File&, int slotIndex)> onFileDropped;

        SampleDropZone(int slot) : sampleSlot(slot) {}

        bool isInterestedInFileDrag(const juce::StringArray& files) override
        {
            for (const auto& file : files)
            {
                if (file.endsWithIgnoreCase(".wav") || 
                    file.endsWithIgnoreCase(".aiff") || 
                    file.endsWithIgnoreCase(".flac"))
                {
                    return true;
                }
            }
            return false;
        }

        void fileDragEnter(const juce::StringArray&, int, int) override
        {
            isHovered = true;
            repaint();
        }

        void fileDragExit(const juce::StringArray&) override
        {
            isHovered = false;
            repaint();
        }

        void filesDropped(const juce::StringArray& files, int, int) override
        {
            isHovered = false;
            if (files.size() > 0 && onFileDropped)
            {
                onFileDropped(juce::File(files[0]), sampleSlot);
            }
            repaint();
        }

        void paint(juce::Graphics& g) override
        {
            auto bounds = getLocalBounds().toFloat().reduced(2.0f);
            
            g.setColour(isHovered ? juce::Colour(0xff00e5ff) : juce::Colour(0xff2a303c));
            g.fillRoundedRectangle(bounds, 6.0f);

            g.setColour(isHovered ? juce::Colours::white : juce::Colour(0xff8a94a6));
            g.drawRoundedRectangle(bounds, 6.0f, isHovered ? 2.0f : 1.0f);

            g.setFont(juce::FontOptions(11.0f, juce::Font::Bold));
            juce::String label = sampleName.isNotEmpty() ? sampleName : "Drop Sample Here";
            g.drawText(label, bounds, juce::Justification::centred);
        }

        void setSampleName(const juce::String& name) { sampleName = name; repaint(); }

    private:
        int sampleSlot = 0;
        bool isHovered = false;
        juce::String sampleName;
    };
}

